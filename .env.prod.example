# ============================================================
# Haritha Fashion World — production settings for the VPS
# Copy to .env.prod (never commit it) and fill in the blanks.
# Generate secrets with:  openssl rand -base64 48
# ============================================================

DOMAIN=harithafashionworld.com

# --- Database / cache (internal to the server) ---
DB_USER=haritha
DB_PASSWORD=
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=

# --- File storage ---
# local = images stored on the VPS disk and served at https://DOMAIN/media
# s3    = any S3-compatible bucket (Cloudflare R2 / AWS S3) — then also set the S3 values below
STORAGE_TYPE=local
STORAGE_PUBLIC_URL=https://harithafashionworld.com/media
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# (for R2 set STORAGE_PUBLIC_URL to the bucket's public URL)

# --- Email (any SMTP) ---
# Hostinger mail: smtp.hostinger.com / 587, username = full mailbox address
# Brevo:          smtp-relay.brevo.com / 587
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@harithafashionworld.com
MAIL_FROM_NAME=Haritha Fashion World

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYOUT_ACCOUNT=

# --- SMS / WhatsApp (MSG91) ---
MSG91_API_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_WA_ORDER_TEMPLATE=
MSG91_WA_SHIPPED_TEMPLATE=

# --- Shipping (Shiprocket) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Frontend build-time values (public, end up in the browser bundle) ---
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
